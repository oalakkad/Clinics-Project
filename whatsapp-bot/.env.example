# Copy to .env.local and fill in. NEVER commit .env.local (.gitignore covers it).

# --- Anthropic (the bot's brain) -------------------------------------------
# https://console.anthropic.com → API Keys. Needs billing enabled.
ANTHROPIC_API_KEY=sk-ant-...

# --- Meta WhatsApp Cloud API -----------------------------------------------
# https://developers.facebook.com → your app → WhatsApp → API Setup
# Temporary token lasts 24h; generate a permanent one via a System User (SETUP.md §5)
WHATSAPP_ACCESS_TOKEN=EAA...

# "Phone number ID" on the API Setup page — NOT the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Any random string you invent. You paste the SAME value into Meta's
# webhook config so it can prove the callback is really yours.
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
